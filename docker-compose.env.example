# Copy this file to .env in the project root before running docker compose
# docker compose reads .env automatically

# PostgreSQL
POSTGRES_PASSWORD=change-this-db-password

# Grafana dashboard login
GRAFANA_PASSWORD=change-this-grafana-password

# Backend JWT signing secret (generate: openssl rand -base64 32)
JWT_SECRET=change-this-jwt-secret

# Backend API keys (comma-separated)
API_KEYS=demo-key-12345

# Demo login passwords (development only)
DEMO_ADMIN_PASSWORD=change-this-admin-password
DEMO_USER_PASSWORD=change-this-user-password

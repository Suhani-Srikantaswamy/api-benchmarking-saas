# Backend Environment Variables
# Copy to .env for local development (without Docker Compose)
# In production: values come from K8s ConfigMap (non-sensitive) and K8s Secrets (sensitive)

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=benchmarkdb
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (BullMQ queue backend)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=change-this-to-a-random-32-char-string
API_KEYS=demo-key-12345,test-key-67890

# Demo login credentials (development only — use a real DB in production)
DEMO_ADMIN_PASSWORD=change-this-admin-password
DEMO_USER_PASSWORD=change-this-user-password

# Logging
LOG_LEVEL=info

# Distributed Tracing (set to "true" to enable Jaeger)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=benchmark-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
